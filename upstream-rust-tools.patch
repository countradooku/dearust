index 00000000..2bb8ed69
--- /dev/null
+++ b/src/buildtools/rust/Cargo.toml
@@ -0,0 +1,26 @@
+[package]
+name = "darling-buildtools"
+version = "0.1.0"
+edition = "2024"
+rust-version = "1.85"
+license = "GPL-3.0-or-later"
+publish = false
+description = "Safe Rust ports of Darling host utilities"
+
+[workspace]
+members = ["xtask"]
+resolver = "3"
+
+[lints.rust]
+unsafe_code = "forbid"
+
+[lints.clippy]
+all = "warn"
+
+[profile.release]
+lto = "thin"
+codegen-units = 1
+
+[[bench]]
+name = "metadata"
+harness = false
