-bool printElfdep(const struct load_command* lc, const void* base)
-{
-	if (lc->cmd == LC_SEGMENT)
-	{
-		const struct segment_command* sc = (const struct segment_command*) lc;
-
-		if (strcmp(sc->segname, "__TEXT") == 0)
